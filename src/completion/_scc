#compdef scc

_scc() {
  local -a commands

  if (( CURRENT == 2 )); then
    commands=(
      'help:output usage information'
      'account:show or update the active Scratch account'
      'class:manage Scratch classes for a teacher account'
      'explore:show trending or popular Scratch projects and studios'
      'forum:browse Scratch forums and follow topics'
      'home:view sections from the Scratch home page'
      'frontpage:view sections from the Scratch home page'
      'login:login to Scratch'
      'legal:show an official Scratch policy document URL'
      'logout:log out and remove the saved CLI login'
      'notifications:show Scratch notifications for the active account'
      'messages:show Scratch notifications for the active account'
      'session:check login status'
      's:check login status'
      'python:check Python installation'
      'project:interact with a Scratch project'
      'search:search Scratch projects'
      'studio:manage Scratch studios'
      'user:show user details, profiles, and public lists'
      'u:show user details, profiles, and public lists'
      'version:output the version number'
      'completion:output zsh completion script'
    )
    _describe 'scc command' commands
    _arguments '(-h --help)'{-h,--help}'[output usage information]' \
      '(-v --version)'{-v,--version}'[Show version number]'
    return
  fi

  case "$words[2]" in
    help)
      if (( CURRENT == 3 )); then
        compadd account class explore forum home login logout notifications messages session python project search studio user u legal completion version
      elif (( CURRENT == 4 )); then
        case "$words[3]" in
          project) compadd love unlove favorite unfavorite comment reply details list create remix share unshare trash restore edit thumbnail report report-comment delete-comment comments remixes studios reactions settings download upload ;;
          studio) compadd details create accept-invite promote delete edit thumbnail add-project remove-project list follow unfollow leave invite remove-curator managers curators comments comment reply report report-comment delete-comment transfer projects activity role settings ;;
          user|u) compadd follow unfollow comment reply report-comment report delete-comment ;;
          account) compadd edit-profile settings scratcher-status become-scratcher change-email delete-account change-password ;;
          class) compadd list details create edit students studios create-studio ;;
          notifications|messages) compadd list count read ;;
          forum) compadd categories topics topic posts post source follow unfollow ;;
        esac
      fi
      ;;
    forum)
      if (( CURRENT == 3 )); then
        compadd categories topics topic posts post source follow unfollow
      fi
      _arguments '--page[one page of topics or posts]:page:' \
        '--limit[maximum items from that page, 1-40]:limit:'
      ;;
    logout)
      _arguments '--local[remove only the saved CLI login without contacting Scratch]'
      ;;
    account)
      if (( CURRENT == 3 )); then
        compadd edit-profile settings scratcher-status become-scratcher change-email delete-account change-password
      fi
      _arguments '--about[new About me text]:text:' \
        '--working-on[new What I am working on text]:text:' \
        '--featured-project[featured project ID]:id:' \
        '--country[new country]:country:' \
        '--state[new state or region]:state:' \
        '--cat-ears[cat ears avatar decoration]:setting:(on off)' \
        '--comments[profile comments permission, use alone]:setting:(on off)' \
        '--email[new email address]:email:' \
        '--delete-projects[also delete projects]'
      ;;
    explore)
      if (( CURRENT == 3 )); then
        compadd project studio
      fi
      _arguments '--page[1-based page in limit-sized steps]:page:' \
        '--mode[ranking to show]:mode:(trending popular)' \
        '--category[project category]:category:(all animations art games music)' \
        '--limit[maximum number of results]:limit:' \
        '--offset[number of results to skip]:offset:' \
        '--language[Scratch result language code]:language:'
      ;;
    class)
      if (( CURRENT == 3 )); then
        compadd list details create edit students studios create-studio
      fi
      _arguments '--title[class or class studio title]:title:' \
        '--description[class or studio description]:text:' \
        '--status[class status]:text:' \
        '--open[open or close class]:state:(on off)' \
        '--type[class list type]:type:(all closed)' \
        '--page[one page of classes, students, or studios]:page:'
      ;;
    home|frontpage)
      if (( CURRENT == 3 )); then
        compadd whats-happening news featured-projects featured-studios design-studio following-loves most-loved most-remixed newest-projects following-projects following-studio-projects viewed-projects
      fi
      _arguments '--list[list available home sections]' \
        '--page[1-based page in limit-sized steps]:page:' \
        '--limit[maximum number of results]:limit:' \
        '--offset[number of results to skip]:offset:'
      ;;
    login)
      _arguments '--username[Scratch username]:username:'
      ;;
    notifications|messages)
      if (( CURRENT == 3 )); then
        compadd list count read
      fi
      _arguments '--page[1-based list page]:page:' \
        '--limit[maximum number of notifications]:limit:' \
        '--offset[number of notifications to skip]:offset:'
      ;;
    legal)
      if (( CURRENT == 3 )); then
        compadd community-guidelines terms
      fi
      ;;
    project)
      if (( CURRENT == 3 )); then
        compadd love unlove favorite unfavorite comment reply details list create remix share unshare trash restore edit thumbnail report report-comment delete-comment comments remixes studios reactions settings download upload
      fi
      _arguments '--text[comment text]:text:' \
        '--comment-id[parent comment ID]:id:' \
        '--title[new project title]:title:' \
        '--instructions[new project instructions]:text:' \
        '--credits[new Notes and Credits]:text:' \
        '--file[thumbnail image or sb3 upload path]:file:_files' \
        '--output[project download destination]:file:_files' \
        '--format[download format, default sb3]:format:(sb sb2 sb3 original)' \
        '--category[Scratch report category 0-19]:category:' \
        '--reason[report explanation]:text:' \
        '--comments[comments permission]:setting:(on off)' \
        '--limit[maximum list items, 1-40]:limit:' \
        '--offset[list items to skip]:offset:' \
        '--visibility[projects to list]:visibility:(all shared notshared trashed)' \
        '--page[My Stuff or public-list page]:page:'
      ;;
    search)
      if (( CURRENT == 3 )); then
        compadd project studio
      fi
      _arguments '--page[1-based page in limit-sized steps]:page:' \
        '--mode[result ranking]:mode:(trending popular)' \
        '--limit[maximum number of results]:limit:' \
        '--offset[number of results to skip]:offset:' \
        '--language[Scratch result language code]:language:'
      ;;
    studio)
      if (( CURRENT == 3 )); then
        compadd details create accept-invite promote delete edit thumbnail add-project remove-project list follow unfollow leave invite remove-curator managers curators comments comment reply report report-comment delete-comment transfer projects activity role settings
      fi
      _arguments '--user[Scratch username]:username:' \
        '--title[new studio title]:title:' \
        '--description[new studio description]:text:' \
        '--file[thumbnail image path]:file:_files' \
        '--project[project ID or Scratch URL]:project:' \
        '--type[studio list type]:type:(all owned curated)' \
        '--comments[comments permission]:setting:(on off)' \
        '--open-to-all[allow everyone to add projects]:setting:(on off)' \
        '--limit[maximum items, projects or activity]:limit:' \
        '--offset[projects to skip]:offset:' \
        '--page[studio list or projects page]:page:' \
        '--text[studio comment text]:text:' \
        '--comment-id[parent or target comment ID]:id:' \
        '--report-type[studio report reason]:type:(title description thumbnail)'
      ;;
    user|u)
      if (( CURRENT == 4 )); then
        compadd follow unfollow comment reply report-comment report delete-comment
      fi
      _arguments '--section[information to show]:section:(details about projects favorites studios followed-studios following followers comments)' \
        '--list[list available user sections]' \
        '--limit[maximum number of results]:limit:' \
        '--offset[number of results to skip]:offset:' \
        '--page[comments or public-list page]:page:' \
        '--text[comment text]:text:' \
        '--comment-id[parent comment ID]:id:' \
        '--report-type[user report reason]:type:(username icon description working_on)'
      ;;
  esac
}

compdef _scc scc
